+
+    def generate_content(
+        self,
+        *args,
+        generation_config: types.GenerateContentConfig | None = None,
+        **kwargs,
+    ):
+        """Forward call to the new client API.
+
+        The wrapper accepts the same call patterns used in the old SDK:
+        - a single prompt string
+        - a list of content dictionaries (history)
+
+        It builds the appropriate ``contents`` list and merges any provided
+        ``generation_config`` with the stored ``system_instruction``.
+        """
+        first = args[0] if args else None
+
+        if isinstance(first, list):
+            contents = first
+        else:
+            contents = [{"role": "user", "parts": [first]}]
+
+        if generation_config is not None:
+            config = copy.deepcopy(generation_config)
+        else:
+            config = types.GenerateContentConfig()
+
+        if self.system_instruction:
+            system_content = {"role": "system", "parts": [self.system_instruction]}
+            contents = [system_content] + contents
+
+        return self.client.models.generate_content(
+            model=self.model_name,
+            contents=contents,
+            config=config,
+        )
 
 
